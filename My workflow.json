        "messages": {
          "values": [
            {
              "content": "=You are classifying a person's professional skill set into exactly one category.\n\nCategories and definitions:\n- Web Development: frontend, backend, APIs, web frameworks, application development\n- Data / Analytics: SQL, Pandas, statistics, reporting, data engineering, analytics\n- Automation / AI: n8n, Zapier, workflow automation, AI, machine learning, LangChain\n- Design: UI/UX, Figma, Adobe tools, visual design, branding\n- Sales / Ops / Support: sales, customer support, CRM, recruiting, operations\n- Other: insufficient, unrelated, or unclear evidence\n\nSkills: {{ $json.skills_raw }}\n\nChoose the category that best represents the DOMINANT theme of the overall skill list, not just one matching keyword. Reply with only the exact category text from the list above, nothing else — no punctuation, no explanation.\n"
            }
          ]
        },
